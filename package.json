{
  "name": "monkeyking-documentation",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9 <23"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs --outDir dist/web",
    "migrate:content": "tsx scripts/migrate-content.ts",
    "json:build": "tsx scripts/json/build.ts",
    "api:extract": "tsx scripts/api/extract.ts",
    "api:coverage": "tsx scripts/api/coverage.ts",
    "api:check": "tsx scripts/api/check.ts",
    "api:mime": "tsx scripts/api/mime-appendix.ts",
    "check:content": "tsx scripts/check-content.ts",
    "examples:check": "tsx scripts/examples/check.ts",
    "api:smoke": "tsx scripts/smoke/api.ts",
    "check:links": "tsx scripts/check-links.ts",
    "build:web": "tsx scripts/build.ts web",
    "build:android": "tsx scripts/build.ts android",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "marked-legacy": "npm:marked@0.3.19",
    "vitepress": "1.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
