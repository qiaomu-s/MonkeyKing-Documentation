{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-document.schema.json",
  "title": "Legacy Monkey King JSON document",
  "type": "object",
  "required": ["source"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\.\\.\\\\api\\\\[^\\\\/]+\\.md$"
        },
        {
          "type": "string",
          "pattern": "^\\.\\./api/[^/]+\\.md$"
        },
        {
          "type": "string",
          "pattern": "^\\.\\.\\\\docs\\\\(?:[a-z0-9]+(?:-[a-z0-9]+)*\\\\)+[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        {
          "type": "string",
          "pattern": "^\\.\\./docs/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)+[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        }
      ]
    },
    "desc": {
      "type": "array",
      "items": { "$ref": "#/$defs/markedToken" }
    },
    "modules": { "$ref": "#/$defs/moduleCollection" },
    "classes": { "$ref": "#/$defs/classCollection" },
    "methods": { "$ref": "#/$defs/methodCollection" },
    "classMethods": { "$ref": "#/$defs/classMethodCollection" },
    "properties": { "$ref": "#/$defs/propertyCollection" },
    "events": { "$ref": "#/$defs/eventCollection" },
    "ctors": { "$ref": "#/$defs/ctorCollection" },
    "miscs": { "$ref": "#/$defs/miscCollection" }
  },
  "$defs": {
    "moduleCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/moduleSection" }
    },
    "classCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/classSection" }
    },
    "methodCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/methodSection" }
    },
    "classMethodCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/classMethodSection" }
    },
    "propertyCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/propertySection" }
    },
    "eventCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/eventSection" }
    },
    "ctorCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/ctorSection" }
    },
    "miscCollection": {
      "type": "array",
      "items": { "$ref": "#/$defs/miscSection" }
    },
    "section": {
      "type": "object",
      "required": ["textRaw", "name"],
      "additionalProperties": false,
      "properties": {
        "textRaw": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "displayName": { "type": "string" },
        "desc": { "type": "string" },
        "shortDesc": { "type": "string" },
        "signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "stability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "stabilityText": { "type": "string" },
        "meta": { "type": "object" },
        "modules": { "$ref": "#/$defs/moduleCollection" },
        "classes": { "$ref": "#/$defs/classCollection" },
        "methods": { "$ref": "#/$defs/methodCollection" },
        "classMethods": { "$ref": "#/$defs/classMethodCollection" },
        "properties": { "$ref": "#/$defs/propertyCollection" },
        "events": { "$ref": "#/$defs/eventCollection" },
        "ctors": { "$ref": "#/$defs/ctorCollection" },
        "miscs": { "$ref": "#/$defs/miscCollection" }
      }
    },
    "moduleSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "module" } }
        }
      ]
    },
    "classSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "class" } }
        }
      ]
    },
    "methodSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type", "signatures"],
          "properties": { "type": { "const": "method" } }
        }
      ]
    },
    "classMethodSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type", "signatures"],
          "properties": { "type": { "const": "classMethod" } }
        }
      ]
    },
    "propertySection": { "$ref": "#/$defs/section" },
    "eventSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type", "params"],
          "properties": { "type": { "const": "event" } }
        }
      ]
    },
    "ctorSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type", "signatures"],
          "properties": { "type": { "const": "ctor" } }
        }
      ]
    },
    "miscSection": {
      "allOf": [
        { "$ref": "#/$defs/section" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "misc" } }
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["params"],
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "return": {
          "allOf": [
            { "$ref": "#/$defs/parameter" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "const": "return" }
              }
            }
          ]
        },
        "desc": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textRaw": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "desc": { "type": "string" },
        "default": { "type": "string" },
        "optional": { "const": true },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        }
      }
    },
    "markedToken": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "text": { "type": "string" },
        "pre": { "type": "boolean" },
        "ordered": { "type": "boolean" },
        "start": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        }
      }
    }
  }
}
