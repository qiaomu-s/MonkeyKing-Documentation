=\"../api/utilities/i18n.md\">Internationalization - 国际化</a></td>\n<td style=\"text-align:center\"></td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/utilities/s13n.md\">Standardization - 标准化</a></td>\n<td style=\"text-align:center\"></td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/utilities/e4x.md\">E4X</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/glossaries/glossary.md\">Glossaries - 术语</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/runtime/exceptions.md\">Exceptions - 异常</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/runtime/intent.md\">Intent - 意图</a></td>\n<td style=\"text-align:center\">&lt; 10%</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/runtime/runtime.md\">Runtime - 运行时</a></td>\n<td style=\"text-align:center\"></td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/android/context.md\">Context - 上下文</a></td>\n<td style=\"text-align:center\"></td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../reference/android/activity.md\">Activity - 活动</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/types/data-types.md\">Data Types - 数据类型</a></td>\n<td style=\"text-align:center\">&gt; 80%</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/automation/ui-selector.md\">UiSelector - 选择器</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/automation/ui-object.md\">UiObject - 控件节点</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text-align:center\"><a href=\"../api/automation/ui-object-collection.md\">UiObjectCollection - 控件集合</a></td>\n<td style=\"text-align:center\">√</td>\n</tr>\n<tr>\n<td style=\"text