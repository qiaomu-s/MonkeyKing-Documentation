                      "name": "key"
                    }
                  ]
                }
              ],
              "desc": "<p>移除本地存储中键值 <code>key</code> 对应的数据.</p>\n<pre><code class=\"lang-js\">let sto = storages.create(&#39;fruit&#39;);\nsto.remove(&#39;apple&#39;).remove(&#39;banana&#39;).remove(&#39;cherry&#39;);\n</code></pre>\n"
            }
          ],
          "type": "module",
          "displayName": "[m#] remove"
        },
        {
          "textRaw": "[m#] clear",
          "name": "[m#]_clear",
          "methods": [
            {
              "textRaw": "clear()",
              "type": "method",
              "name": "clear",
              "signatures": [
                {
                  "params": [
                    {
                      "textRaw": "<ins>**returns**</ins> { [Storage](storage.md) } ",
                      "name": "<ins>**returns**</ins>",
                      "type": " [Storage](storage.md) "
                    }
                  ]
                },
                {
                  "params": []
                }
              ],
              "desc": "<p>通过 SharedPreferences <code>apply()</code> 异步提交清空操作，并返回当前 Storage。</p>\n<pre><code class=\"lang-js\">let sto = storages.create(&#39;fruit&#39;);\nsto.put(&#39;apple&#39;, 10);\nsto.get(&#39;apple&#39;); // 10\nsto.clear();\nsto.get(&#39;apple&#39;); // undefined\n</code></pre>\n"
            }
          ],
          "type": "module",
          "displayName": "[m#] clear"
        },
        {
          "textRaw": "固定源码补充成员",
          "name": "固定源码补充成员",
          "properties": [
            {
              "textRaw": "`name` <ins>**returns**</ins> { [string](data-types.md#string) } ",
              "name": "name",
              "desc": "<p>创建 Storage 时使用的命名空间。属性在实例初始化后保持不变。</p>\n",
              "shortDesc": "<ins>**returns**</ins> { [string](data-types.md#string) }"
            },
            {
              "textRaw": "`size` <ins>**returns**</ins> { [number](data-types.md#number) } ",
              "name": "size",
              "desc": "<p>动态读取当前命名空间中的键数量；每次访问都会查询底层存储。</p>\n",
              "shortDesc": "<ins>**returns**</ins> { [number](data-types.md#number) }"
            }
          ],
          "methods": [
