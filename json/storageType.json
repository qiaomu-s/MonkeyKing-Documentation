                  "params": []
                }
              ]
            },
            {
              "textRaw": "storage.selfRemove(name)",
              "type": "method",
              "name": "selfRemove",
              "desc": "<p>当前固定源码要求 <strong>恰好 1 个</strong> <code>name</code> 参数，并调用 <code>storages.remove(name)</code> 的异步删除路径；它不会自动采用 <code>storage.name</code>。返回当前 Storage。</p>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "name"
                    }
                  ]
                }
              ]
            },
            {
              "textRaw": "storage.selfRemoveSync(name)",
              "type": "method",
              "name": "selfRemoveSync",
              "desc": "<p>当前固定源码同样要求 <strong>恰好 1 个</strong> <code>name</code> 参数，使用 <code>storages.removeSync(name)</code> 同步删除指定命名空间，并返回当前 Storage。</p>\n<pre><code class=\"lang-js\">const storage = storages.create(&#39;temporary-contract&#39;);\nstorage\n    .putSync(&#39;answer&#39;, 42)\n    .removeSync(&#39;answer&#39;)\n    .clearSync()\n    .selfRemoveSync(&#39;temporary-contract&#39;);\n</code></pre>\n",
              "signatures": [
