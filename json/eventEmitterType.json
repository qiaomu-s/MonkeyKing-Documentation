                      "name": "eventName"
                    },
                    {
                      "name": "listener"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m#] EventEmitter#prependListener"
        },
        {
          "textRaw": "[m#] EventEmitter#prependOnceListener",
          "name": "[m#]_eventemitter#prependoncelistener",
          "methods": [
            {
              "textRaw": "EventEmitter#prependOnceListener(eventName, listener)",
              "type": "method",
              "name": "EventEmitter#prependOnceListener",
              "desc": "<p><strong><code>≤ 6.6.4</code></strong></p>\n<ul>\n<li><strong>eventName</strong> { <a href=\"data-types.md#string\">string</a> }</li>\n<li><strong>listener</strong> { <a href=\"data-types.md#function\">Function</a> }</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"#事件发射器-eventemitter\">EventEmitter</a> }</li>\n<li><strong>异常</strong>：监听器达到上限或参数类型不兼容时抛出异常</li>\n<li><strong>副作用</strong>：把一次性监听器插入列表开头，并发送 <code>newListener</code></li>\n</ul>\n<p>与 <code>once</code> 不同，产品版本中的 prepend 路径不会立即消费已保存的 sticky 数据。它仍受 <a href=\"#eventemitter-once-eventname-listener\">多个 once 监听器的移除缺陷</a> 影响。</p>\n<pre><code class=\"lang-js\">emitter.prependOnceListener(&#39;step&#39;, () =&gt; console.log(&#39;first once&#39;));\n</code></pre>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "eventName"
                    },
                    {
                      "name": "listener"
                    }
                  ]
                }
              ]
