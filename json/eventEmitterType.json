                      "name": "eventName"
                    },
                    {
                      "name": "...args"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m#] EventEmitter#emit"
        },
        {
          "textRaw": "[m#] EventEmitter#emitSticky",
          "name": "[m#]_eventemitter#emitsticky",
          "methods": [
            {
              "textRaw": "EventEmitter#emitSticky(eventName, ...args)",
              "type": "method",
              "name": "EventEmitter#emitSticky",
              "desc": "<p><strong><code>≤ 6.6.4</code></strong></p>\n<ul>\n<li><strong>参数、返回与异常</strong>：与 <a href=\"#eventemitter-emit-eventname-args\">emit</a> 相同</li>\n<li><strong>副作用 / 生命周期</strong>：发送事件并保存本次参数；之后注册的监听器会立即收到最近一次 sticky 数据</li>\n</ul>\n<p>移除监听器不会清除 sticky 数据；再次调用 <code>emitSticky</code> 会替换同名事件保存的参数。</p>\n<pre><code class=\"lang-js\">emitter.emitSticky(&#39;state&#39;, &#39;ready&#39;);\nemitter.once(&#39;state&#39;, value =&gt; console.log(value)); // ready\n</code></pre>\n",
              "signatures": [
                {
                  "params": [
