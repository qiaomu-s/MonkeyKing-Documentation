                    },
                    {
                      "name": "...args"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[m#] EventEmitter#emitSticky"
        },
        {
          "textRaw": "[m#] EventEmitter#removeListener",
          "name": "[m#]_eventemitter#removelistener",
          "methods": [
            {
              "textRaw": "EventEmitter#removeListener(eventName, listener)",
              "type": "method",
              "name": "EventEmitter#removeListener",
              "desc": "<p><strong><code>≤ 6.6.4</code></strong></p>\n<ul>\n<li><strong>eventName</strong> { <a href=\"data-types.md#string\">string</a> }</li>\n<li><strong>listener</strong> { <a href=\"data-types.md#function\">Function</a> } - 注册时的同一函数对象</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"#事件发射器-eventemitter\">EventEmitter</a> }</li>\n<li><strong>异常</strong>：参数类型不兼容时抛出异常</li>\n<li><strong>副作用</strong>：移除第一个匹配监听器；成功移除时发送 <code>removeListener</code></li>\n</ul>\n<pre><code class=\"lang-js\">const listener = value =&gt; console.log(value);\nemitter.on(&#39;data&#39;, listener);\nemitter.removeListener(&#39;data&#39;, listener);\n</code></pre>\n",
